# Neon PostgreSQL Database
DATABASE_URL=postgresql://neondb_owner:password@ep-weathered-silence-b4zgx4mo.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon Auth / Session Configuration
NEON_AUTH_COOKIE_SECRET=your-32-char-random-secret-key-here

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# On Vercel, DATABASE_URL / DATABASE_URL_UNPOOLED are injected per deployment
# by the Neon-Vercel integration (preview deployments get their own Neon branch).
